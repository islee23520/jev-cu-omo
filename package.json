{
  "name": "jev-cu-omo",
  "version": "0.1.0",
  "description": "Verified native macOS computer use for OmO with typed decisions and cua-driver",
  "private": true,
  "scripts": {
    "p0": "node scripts/p0-eval.mjs",
    "setup-laya": "sh scripts/setup-laya.sh",
    "p0-laya": "JEV_CU_DECIDER=laya JEV_CU_LAYA_MODEL=english node scripts/p0-eval.mjs --laya --candidate-max 8",
    "blender-face-repair": "node scripts/blender-face-repair.mjs",
    "blender-head-fit": "node scripts/blender-head-fit.mjs",
    "blender-vision-autonomous": "node scripts/blender-vision-autonomous.mjs",
    "test": "node --test tests/*.test.mjs",
    "install-skill": "node scripts/install-skill.mjs",
    "uninstall-skill": "node scripts/install-skill.mjs --uninstall"
  },
  "pi": {
    "extensions": ["./extension/jev-cu.mjs"],
    "skills": ["./skill/jev-use"]
  },
  "keywords": ["omo", "computer-use", "cua-driver", "jev"],
  "author": "islee23520",
  "homepage": "https://github.com/islee23520/jev-cu-omo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islee23520/jev-cu-omo.git"
  },
  "bugs": {
    "url": "https://github.com/islee23520/jev-cu-omo/issues"
  },
  "license": "ISC",
  "type": "module"
}
